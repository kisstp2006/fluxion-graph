.{
    .name = .fluxion_graph,
    .version = "0.1.0",
    .minimum_zig_version = "0.17.0",
    .fingerprint = 0xf6eca3e69bb49f15,
    // fluxion-json at the commit fluxion-script and the engine pin, so a
    // program gets one copy of it.
    .dependencies = .{
        // For what a script can call: the catalog its nodes come from.
        .fluxion_script = .{
            .url = "git+https://github.com/kisstp2006/fluxion-script#879fe8157da1c7f0dbfde1dccbd56b4c3e8ce997",
            .hash = "fluxion_script-0.2.1-rt2DKrXdFQBIZtsTXkerDEOw_VurcDY62Lb1kap-HGg4",
        },
        // The editor's widget draws with it: the commit the engine pins.
        .fluxion_ui = .{
            .url = "git+https://github.com/kisstp2006/fluxion-ui#f6bdfefd2c8cc1603cea6da2c675e8b78d0f34a6",
            .hash = "fluxion_ui-0.2.3-lw4Ws8KpEADiiqCshBHOIa9Mqozq-rTqevVS1tlhuyAD",
        },
        .fluxion_json = .{
            .url = "git+https://github.com/kisstp2006/fluxion-json#536986073e603ed950daec1c1039b18a3d2fc997",
            .hash = "fluxion_json-0.2.3-sFlLPfelBQCe7T4IG1Vwa5dkRu-9H9UhoNdxd01SPKjQ",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tools",
        "README.md",
        "LICENSE",
    },
}
