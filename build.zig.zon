.{
    .name = .fluxion_graph,
    .version = "0.1.0",
    .minimum_zig_version = "0.17.0",
    .fingerprint = 0xf6eca3e69bb49f15,
    // fluxion-json at the commit fluxion-script and the engine pin, so a
    // program gets one copy of it.
    .dependencies = .{
        // For what a script can call: the catalog its nodes come from.
        .fluxion_script = .{
            .url = "git+https://github.com/kisstp2006/fluxion-script#fbdbb37edaaa30cbe1e932046b4e1ba3cee4feda",
            .hash = "fluxion_script-0.2.1-rt2DKki3FQDxtwb0LlF-7SG4YVTsn3n_9wr-Y-anEhrn",
        },
        // The editor's widget draws with it: the commit the engine pins.
        .fluxion_ui = .{
            .url = "git+https://github.com/kisstp2006/fluxion-ui#bb2addb94dd0592377660599483b692add1fa93c",
            .hash = "fluxion_ui-0.2.3-lw4Ws0eSEACqOZFnlZNN8g-ErWrZYjErWnleaZsS6sBo",
        },
        .fluxion_json = .{
            .url = "git+https://github.com/kisstp2006/fluxion-json#536986073e603ed950daec1c1039b18a3d2fc997",
            .hash = "fluxion_json-0.2.3-sFlLPfelBQCe7T4IG1Vwa5dkRu-9H9UhoNdxd01SPKjQ",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tools",
        "README.md",
        "LICENSE",
    },
}
